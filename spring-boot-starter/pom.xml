<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.oluso</groupId>
        <artifactId>oluso-parent</artifactId>
        <version>0.2.0</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>oluso-spring-boot-starter</artifactId>
    <packaging>jar</packaging>

    <name>Oluso Spring Boot Starter</name>
    <description>Spring Boot auto-configuration for Oluso error monitoring: request-scoped breadcrumbs and automatic exception reporting for Spring MVC (servlet) applications.</description>
    <url>https://github.com/olusodotdev/oluso-java</url>

    <properties>
        <!-- Spring Boot 3 requires Java 17+; the core module stays on 11. -->
        <maven.compiler.release>17</maven.compiler.release>
        <!--
            WireMock 3.9.1 itself expects a single consistent Jetty 11
            classpath. Spring Boot's BOM manages some (but not all)
            individual Jetty artifacts up to Jetty 12; the old
            jetty-servlet/jetty-servlets/jetty-webapp coordinates aren't
            part of Jetty 12 (superseded by org.eclipse.jetty.ee10:*), so
            those stay at 11.0.20 while jetty-server/http/io/etc. get
            bumped to 12.0.36 by the BOM import below. That mixed 11/12
            classpath breaks WireMock's Jetty-based HttpServerFactory SPI
            lookup at runtime. Pinned back to one version to match.
        -->
        <wiremock.jetty.version>11.0.20</wiremock.jetty.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-server</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-http</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-io</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-security</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-util</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-xml</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-client</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-proxy</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-alpn-server</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-alpn-java-server</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-alpn-java-client</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-alpn-client</artifactId>
                <version>${wiremock.jetty.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>dev.oluso</groupId>
            <artifactId>oluso</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            `provided`: assumes the consuming application already brings
            spring-boot-starter-web (this integration is servlet-stack-only,
            see the WebFlux caveat in the README). Not bundling it avoids
            forcing a second, possibly conflicting Spring Web version onto
            an app that already chose its own.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
